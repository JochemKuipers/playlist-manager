{
  "name": "playlist-manager",
  "description": "A Spicetify extension created with @spicetify/creator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "sc": "spicetify-creator",
    "dev": "spicetify-creator dev",
    "build": "spicetify-creator build",
    "update-types": "spicetify-creator update-types",
    "clean-spice": "spicetify-creator clean-spicetify --all",
    "lint": "biome check --apply ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@spicemod/creator": "^0.0.33",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
