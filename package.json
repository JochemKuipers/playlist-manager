{
  "name": "playlist-manager",
  "description": "A Spicetify extension created with @spicetify/creator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "sc": "spicetify-creator",
    "dev": "spicetify-creator dev",
    "build": "spicetify-creator build",
    "update-types": "spicetify-creator update-types",
    "clean-spice": "spicetify-creator clean-spicetify --all",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@spicemod/creator": "^0.0.38",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
